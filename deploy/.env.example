# Credenziali NewRay per il compose (A-07).
# Copiare questo file in deploy/.env e sostituire i valori con password
# casuali:  openssl rand -hex 16
#
# .env contiene credenziali: non va mai condiviso né inviato altrove.
NEWRAY_DB_MIGRATE_PASSWORD=
NEWRAY_DB_APP_PASSWORD=

# Opzionali (default tra parentesi):
# NEWRAY_DB_PORT=5432
# NEWRAY_PORT=8000
