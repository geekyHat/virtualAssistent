{
  "name": "@newray/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NewRay WebUI — React, TypeScript strict, Vite (NewRay.md §18)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test --project=ui",
    "e2e:live": "NEWRAY_E2E_LIVE=1 playwright test --project=live",
    "e2e:install": "playwright install --with-deps chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "licenses": "node scripts/check-licenses.mjs",
    "bundle": "node scripts/check-bundle.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run licenses && npm run build && npm run bundle"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "lucide-react": "1.47.0",
    "marked": "16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.7",
    "shadcn": "4.21.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
