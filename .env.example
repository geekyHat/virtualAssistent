# Facoltativo: ./.start --web funziona senza .env.
# Senza DSN prepara un PostgreSQL privato in ~/.local/share/newray/launcher.
# Le credenziali sono casuali, persistenti e leggibili solo dall'utente.
# Le variabili già esportate nella shell prevalgono su questo file.

# NEWRAY_DATA_DIR=/percorso/assoluto/newray
# NEWRAY_PORT=8000
# NEWRAY_WEB_PORT=5173
# NEWRAY_ENV_FILE=/percorso/assoluto/configurazione.env

# Database gestito esternamente: impostare ENTRAMBI i DSN reali.
# Il launcher verifica connessione e migrazioni; il servizio esterno deve
# essere avviato dal relativo gestore. Non viene creato un database sostitutivo.
# Password URL-encoded; ruoli distinti, newray_app senza owner/superuser/BYPASSRLS.
# NEWRAY_DATABASE_DSN=postgresql+psycopg://newray_app:PASSWORD@127.0.0.1:5432/newray
# NEWRAY_MIGRATION_DATABASE_URL=postgresql+psycopg://newray_migrate:PASSWORD@127.0.0.1:5432/newray

# Ollama è avviato soltanto se configurato e non già raggiungibile.
# Nessun download di modelli; il nuovo Assistente si provisiona con POST esplicito.
# NEWRAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default pilot per nuovi Assistenti: alias versionato con proiettore visivo.
# NEWRAY_DEFAULT_MODEL_NAME=newray-gemma4-31b-it:ud-q4-k-xl-vision-v1
# NEWRAY_MODEL_CONTEXT_LENGTH=8192
# NEWRAY_MODEL_MAX_CONTEXT_LENGTH=16384
# NEWRAY_OLLAMA_GPU=amd
