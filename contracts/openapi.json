{
  "components": {
    "schemas": {
      "AProfile": {
        "description": "Profili AI selezionabili manualmente dall'utente.",
        "enum": [
          "assistant",
          "researcher",
          "coder"
        ],
        "title": "AProfile",
        "type": "string"
      },
      "BindingDTO": {
        "description": "Binding del profilo a runtime e modello, con parametri espliciti.",
        "properties": {
          "model_name": {
            "title": "Model Name",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "runtime": {
            "title": "Runtime",
            "type": "string"
          }
        },
        "required": [
          "name",
          "runtime",
          "model_name",
          "parameters"
        ],
        "title": "BindingDTO",
        "type": "object"
      },
      "BootstrapRequest": {
        "description": "Richiesta di bootstrap monouso: nome del proprietario + credenziale.\n\nLa credenziale non viene mai persistita in chiaro: il caso d'uso ne\ncalcola il record hash con ``newray.kernel.crypto`` (B-03.2-14). La\nlunghezza minima applicativa è verificata dal kernel; qui il limite\nsuperiore protegge da payload gonfiati senza fare da oracolo\nsull'algoritmo di hashing.",
        "properties": {
          "credential": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Credential",
            "type": "string"
          },
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "credential"
        ],
        "title": "BootstrapRequest",
        "type": "object"
      },
      "ConversationDTO": {
        "description": "Conversazione nel profilo pubblico: nessun campo oltre il necessario.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationDTO",
        "type": "object"
      },
      "ConversationListDTO": {
        "description": "Pagina di conversazioni con cursore per la pagina successiva (§19.2).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ConversationDTO"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ConversationListDTO",
        "type": "object"
      },
      "CreateConversationRequest": {
        "description": "Creazione di una conversazione: solo il titolo, il resto è del server.",
        "properties": {
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "CreateConversationRequest",
        "type": "object"
      },
      "CreateMessageRequest": {
        "description": "Messaggio dell'utente: il ruolo è deciso dal server, mai dal payload.\n\n``idempotency_key`` opzionale: il retry della stessa richiesta\nrestituisce lo stesso messaggio senza duplicarlo; stessa chiave con\ncontenuto diverso risponde 409.",
        "properties": {
          "content": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          }
        },
        "required": [
          "content"
        ],
        "title": "CreateMessageRequest",
        "type": "object"
      },
      "CreateRunRequest": {
        "description": "Richiesta di creazione run: contenuto utente e profilo scelto.",
        "properties": {
          "content": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "profile_id": {
            "format": "uuid",
            "title": "Profile Id",
            "type": "string"
          }
        },
        "required": [
          "content",
          "profile_id"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdentityDTO": {
        "description": "Identità pubblica del principal risolto dal server.\n\nNiente campi sensibili oltre il minimo necessario alla WebUI:\nnessun token, nessun dettaglio della sessione.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "display_name",
          "role"
        ],
        "title": "IdentityDTO",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Richiesta di login del proprietario esistente (B-03.2-14).\n\nOwner sconosciuto e credenziale sbagliata collassano in un unico\n``INVALID_CREDENTIALS``: il canale non è un oracolo per scoprire il\nnome scelto in bootstrap.",
        "properties": {
          "credential": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Credential",
            "type": "string"
          },
          "display_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "credential"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MessageDTO": {
        "description": "Messaggio della conversazione, con sequenza e ruolo noti al server.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
