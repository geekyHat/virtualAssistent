        "title": "ModelReadinessDTO",
        "type": "object"
      },
      "ModelStatus": {
        "description": "Stati distinti del catalogo (NewRay.md §9.1): essere installati,\ncompatibili e qualificati sono fatti diversi.",
        "enum": [
          "installed",
