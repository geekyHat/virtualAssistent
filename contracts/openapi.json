      "Role": {
        "description": "Ruolo account del principal (NewRay.md §7.1, 7.2).\n\nAsse separato dal profilo AI: non descrive capacità del modello né\nstrumenti disponibili.",
        "enum": [
          "owner",
          "member",
          "administrator"
        ],
        "title": "Role",
        "type": "string"
      },
