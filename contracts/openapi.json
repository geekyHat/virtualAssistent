          "not_configured",
          "unreachable",
          "runtime_error",
          "catalog_empty",
          "model_missing",
          "artifact_incompatible",
          "installed_unverified"
        ],
        "title": "ReadinessState",
        "type": "string"
      },
      "RenameConversationRequest": {
        "description": "Rinomina di una conversazione.\n\n``expected_updated_at`` è la versione attesa (il campo ``updated_at``\ndell'ultima lettura del client): se la conversazione è cambiata nel\nfrattempo la mutazione risponde 409, mai una sovrascrittura silenziosa.",
        "properties": {
          "expected_updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Updated At"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "RenameConversationRequest",
        "type": "object"
      },
      "ResolvedBindingDTO": {
