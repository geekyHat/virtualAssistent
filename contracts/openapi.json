            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ModelListDTO",
        "type": "object"
      },
      "ModelReadinessDTO": {
        "description": "Stato osservato del candidato; capacità dichiarate non qualificate.",
        "properties": {
          "declared_capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Declared Capabilities",
            "type": "array"
          },
