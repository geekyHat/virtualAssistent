        "title": "ModelStatus",
        "type": "string"
      },
      "ProfileDTO": {
        "description": "Profilo con versione corrente, binding e disponibilità del modello.\n\n``model`` è ``null`` quando il modello del binding non è nel\ncatalogo: la risoluzione risponde ``MODEL_UNAVAILABLE`` (§19.4).",
        "properties": {
          "binding": {
            "$ref": "#/components/schemas/BindingDTO"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AProfile"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelInfoDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "display_name",
          "version",
          "created_at",
          "updated_at",
          "binding",
          "model"
        ],
        "title": "ProfileDTO",
        "type": "object"
      },
      "ProfileListDTO": {
        "description": "Profili propri: collezione piccola e finita, senza paginazione.",
