          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "sequence",
          "created_at"
        ],
        "title": "MessageDTO",
        "type": "object"
      },
      "MessageListDTO": {
        "description": "Pagina di messaggi, in ordine di sequenza crescente.\n\n``next_sequence`` è l'ultimo valore ricevuto: se presente va passato\ninvariato come ``after_sequence`` per ottenere la pagina successiva.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MessageDTO"
            },
            "title": "Items",
            "type": "array"
          },
          "next_sequence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Sequence"
          }
        },
        "required": [
          "items",
          "next_sequence"
        ],
        "title": "MessageListDTO",
        "type": "object"
      },
      "MessageRole": {
        "description": "Autore del messaggio, noto al server: mai derivato dal client (§7.1).",
        "enum": [
          "user",
          "assistant"
        ],
        "title": "MessageRole",
        "type": "string"
      },
      "ModelInfoDTO": {
        "description": "Modello del runtime con digest e stato (NewRay.md §9.1).\n\nIl digest identifica l'artefatto per la riproducibilità; i tag\nmobili restano scoperta, mai riferimento degli snapshot.",
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "digest": {
